# Local development settings for platform-studio. Copy to .env (git-ignored) and fill in.
# Never commit real values. In the cluster these come from Kubernetes Secrets instead
# (see k8s/secrets/*.env.example).

# HTTP Basic gate for every surface (SPA, /api, /mcp). STUDIO_AUTH_DISABLED=true skips it
# for local work only.
STUDIO_AUTH_USER=
STUDIO_AUTH_PASSWORD=
STUDIO_AUTH_SCOPE=all
STUDIO_AUTH_DISABLED=

# The platform repository the studio opens onboarding pull requests against, and the
# install's deploy branch.
STUDIO_PLATFORM_REPO_URL=
STUDIO_DEPLOY_BRANCH=

# A GitHub token: platform repo contents + pull requests (read/write). The two fleet
# tokens fall back to it when unset.
STUDIO_GITHUB_TOKEN=
STUDIO_FLEET_READ_TOKEN=
STUDIO_FLEET_WRITE_TOKEN=

# Event bus (optional).
STUDIO_NATS_SERVERS=
STUDIO_NATS_CREDS=

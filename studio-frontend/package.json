{
    "name": "studio-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run api:generate && tsc --noEmit && vite build",
        "preview": "vite preview",
        "api:export": "node scripts/fetch-openapi.mjs",
        "api:generate": "openapi-typescript src/models/openapi.json -o src/models/schema.d.ts && node scripts/generate-barrel.mjs",
        "api:sync": "npm run api:export && npm run api:generate",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "style": "npm run format && npm run lint:fix",
        "style:check": "npm run format:check && npm run lint",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.20",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.5.2",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.11.1",
        "@psa-department-of-engineering/vitest-intent": "^2.0.1",
        "@testing-library/jest-dom": "^6.5.0",
        "@testing-library/react": "^16.0.1",
        "@types/node": "^22.7.4",
        "@types/react": "^18.3.10",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.11.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.12",
        "globals": "^15.9.0",
        "jsdom": "^25.0.1",
        "openapi-typescript": "^7.4.1",
        "postcss": "^8.4.47",
        "prettier": "^3.3.3",
        "tailwindcss": "^3.4.13",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.7.0",
        "vite": "^6.4.3",
        "vitest": "^4.1.11"
    }
}

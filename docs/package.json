    "@types/node": "^22.0.0",
    "astro": "^7.2.10",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@psa-department-of-engineering/starlight-theme": "^1.2.0",
    "astro-mermaid": "^2.0.2",
    "mermaid": "^11.16.1"
  }

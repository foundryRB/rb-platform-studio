{
  "name": "platform-studio-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Onboarding and management studio for the platform repo: registry, conformance, gated onboardings as pull requests, MCP server",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "generate:decisions": "node scripts/generate-decisions.mjs",

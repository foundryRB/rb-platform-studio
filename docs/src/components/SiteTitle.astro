---
// The RB lockup as the site title (a Starlight component override, astro.config.mjs:
// components.SiteTitle): the tile and the two lines of words inline as live text and vectors,
// so it stays crisp at header size.
const { siteTitle: title, siteTitleHref: href } = Astro.locals.starlightRoute;
---
<a href={href} class="site-title rb-lockup" aria-label={title ? `${title}, Software Engineering, RB` : 'Software Engineering, RB'}>
  <svg class="rb-tile" viewBox="0 0 120 120" aria-hidden="true"><rect x="6" y="6" width="108" height="108" rx="18" fill="none" stroke="currentColor" stroke-width="8"/><text x="60" y="77" text-anchor="middle" font-family="system-ui,-apple-system,Segoe UI,sans-serif" font-size="48" font-weight="800" fill="currentColor">RB</text></svg>
  <span class="rb-words">
    <b>Software Engineering</b>
    <i>RB</i>
  </span>
  {title && <span class="rb-site">{title}</span>}
</a>

<style>
  .rb-lockup { display: flex; align-items: center; gap: 0; text-decoration: none; color: inherit; }
  .rb-tile { flex: none; width: 2.25rem; height: 2.25rem; color: var(--sl-color-white); }
  .rb-words {
    display: flex; flex-direction: column; justify-content: center;
    min-height: 1.75rem; margin-left: .6rem; padding-left: .6rem;
    border-left: 1px solid var(--sl-color-hairline-light, rgba(0,0,0,.12));
    line-height: 1.15;
  }
  .rb-words b { font-family: var(--sl-font, sans-serif); font-size: .85rem; font-weight: 700; letter-spacing: .06em; color: var(--sl-color-white); }
  .rb-words i { margin-top: .15rem; font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-style: normal; font-size: .6rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  /* the site's own name, after the lockup, in the body voice */
  .rb-site {
    margin-left: .75rem; padding-left: .75rem;
    border-left: 1px solid var(--sl-color-hairline-light, rgba(0,0,0,.12));
    font-family: var(--sl-font, sans-serif); font-size: .95rem; font-weight: 400;
    color: var(--sl-color-gray-2); white-space: nowrap;
  }
  @media (max-width: 50rem) { .rb-site { display: none; } }
</style>

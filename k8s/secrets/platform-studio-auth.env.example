# k8s-target: namespace=platform-studio, name=platform-studio-auth, type=Opaque
# The app's HTTP Basic credential (fails closed until this Secret exists). Copy to
# k8s/secrets/platform-studio-auth.env (git-ignored), fill the values, and apply with
# the platform's seed/apply-secrets.sh. Never commit the real file.
STUDIO_AUTH_USER=
STUDIO_AUTH_PASSWORD=
